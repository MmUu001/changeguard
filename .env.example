# ---- LLM (optional: ChangeGuard works fully offline with deterministic templates) ----
# Any OpenAI-compatible Chat Completions endpoint is supported.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- GitHub App (required for `serve` / `github pr`) ----
GITHUB_APP_ID=
# PEM contents, or a path to the .pem file
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Optional token used only to raise GitHub REST rate limits while fetching releases
GITHUB_TOKEN=

# ---- Notifications ----
SLACK_WEBHOOK_URL=
# implicit-TLS SMTP, e.g. smtps://alerts%40example.com:pass@smtp.example.com:465?from=alerts@example.com
SMTP_URL=
EMAIL_TO=

# ---- Runtime ----
PORT=8787
CHANGEGUARD_CACHE_DIR=.changeguard/cache
CHANGEGUARD_DB_PATH=.changeguard/changeguard.db
# 0 = disable; otherwise cron-style scan interval in hours
CHANGEGUARD_SCAN_INTERVAL_HOURS=24
# comma-separated repo paths to scan on schedule
CHANGEGUARD_SCHEDULED_REPOS=

# ---- Console access control (fail-closed by default) ----
# The console + JSON API require a login. Configure ONE credential method:
#   - CHANGEGUARD_CONSOLE_PASSWORD   password login (/login)
#   - GITHUB_OAUTH_CLIENT_ID/SECRET GitHub SSO (/auth/github)
# With neither set the console returns 503 (locked). For local development only,
# set CHANGEGUARD_ALLOW_ANONYMOUS_CONSOLE=1 to skip access control entirely.
CHANGEGUARD_CONSOLE_PASSWORD=
# HMAC secret for session cookies. Unset => random per process (sessions end
# on restart). Always set this in production.
CHANGEGUARD_SESSION_SECRET=

# ---- Security switches ----
# Dev only: accept GitHub webhooks without a valid signature (no secret set).
CHANGEGUARD_ALLOW_UNSIGNED_WEBHOOK=0
# Dev only: serve the console anonymously (same as above, for the console).
CHANGEGUARD_ALLOW_ANONYMOUS_CONSOLE=0
# Behind a reverse proxy: honor X-Forwarded-Proto / X-Forwarded-For
# (needed for Secure cookies and per-client login rate limiting).
CHANGEGUARD_TRUST_PROXY=0
# Force the Secure attribute on the session cookie (TLS terminates upstream).
CHANGEGUARD_SECURE_COOKIES=0

# ---- GitHub OAuth SSO (optional; requires an OAuth App on GitHub) ----
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- Stripe billing (required for real checkout; test mode sk_live / sk_test) ----
# STRIPE_WEBHOOK_SECRET is the switch — setting it turns billing on.
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
# Price IDs for the two paid tiers. Create these in the Stripe Dashboard
# (test mode first!) and paste here. E.g. price_xxx.
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
